{
  "name": "rocket-money",
  "version": "1.0.0",
  "private": true,
  "description": "Rocket Money - Telegram referral & rewards Mini App (NestJS + Prisma + React), ready for Vercel",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "vercel-build": "node scripts/vercel-build.js",
    "build": "node scripts/vercel-build.js",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "migrate": "npm run migrate -w backend",
    "seed": "npm run build -w backend && npm run db:seed -w backend",
    "set-webhook": "node scripts/set-webhook.js",
    "webhook-info": "node scripts/set-webhook.js --info",
    "check": "node scripts/check-deployment.js"
  }
}
