# ============================================================================
#  Rocket Money – environment variables
#  On Vercel: add each of these in Project → Settings → Environment Variables.
#  Locally: copy this file to backend/.env and fill it in. NEVER commit real values.
#  None of these are exposed to the browser – they are only read by the API.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather (looks like 1234567890:AAH...). REQUIRED.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the @ (e.g. RocketMoneyBot). Used to build referral links. REQUIRED.
TELEGRAM_BOT_USERNAME=RocketMX_bot
# Any random string (letters, digits, _ and -; 1-256 chars). Telegram sends it with every webhook
# call so nobody else can fake bot updates. RECOMMENDED. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs that receive bot notifications about new withdrawals and
# support requests (get your ID from @userinfobot). Optional.
ADMIN_TELEGRAM_IDS=
# Optional support contact shown by /support (e.g. @YourSupportAccount or an email).
SUPPORT_CONTACT=

# --- Database (Neon or Supabase PostgreSQL) ----------------------------------
# Pooled connection string used by the app at runtime. REQUIRED.
#   Neon:     the "Pooled connection" string, e.g.
#             postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Supabase: the "Transaction pooler" string (port 6543) and append ?pgbouncer=true, e.g.
#             postgresql://postgres.xxxx:pass@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
# Direct (non-pooled) connection string used only for migrations during the build. REQUIRED.
#   Neon:     the same string WITHOUT "-pooler" in the host name.
#   Supabase: the "Session pooler" (port 5432) or "Direct connection" string.
DIRECT_URL=

# --- Security / app ------------------------------------------------------------
# Secret used to sign login tokens. At least 32 random characters. REQUIRED.
# Generate: openssl rand -hex 32
JWT_SECRET=
# Your public site URL without a trailing slash, e.g. https://rocket-money.vercel.app. REQUIRED.
# Used for the Mini App button in the bot and for the webhook.
APP_URL=
# Use "production" on Vercel.
NODE_ENV=production

# --- First administrator (created automatically on every deploy if missing) ---
ADMIN_USERNAME=admin
# At least 8 characters. Change it!
ADMIN_PASSWORD=
# Set to "true" for ONE deploy to reset the password of ADMIN_USERNAME to ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD=false

# --- Optional ------------------------------------------------------------------
# Comma-separated allowed CORS origins. Leave empty (same-domain setup on Vercel needs nothing).
CORS_ORIGINS=
# Set to "true" to skip automatic migrations during the Vercel build.
SKIP_MIGRATIONS=false
# Port for the standalone Node server (local development / Docker only; ignored on Vercel).
# `npm run dev:backend` defaults to 3001 (the Vite dev server proxies /api there);
# scripts/start-local.sh uses 3000.
PORT=3001
